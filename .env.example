# ─── Shopify Storefront API ───────────────────────────────────────────────────
# Public storefront access token (read-only, safe to expose client-side)
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here
NEXT_PUBLIC_SHOPIFY_API_ENDPOINT=https://your-store.myshopify.com/api/2025-07/graphql.json
NEXT_PUBLIC_SHOPIFY_STORE_ID=your_shopify_numeric_store_id

# ─── Site Config ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://yourdomain.com
NEXT_PUBLIC_SHOP_COOKIE_DOMAIN=yourdomain.com

# ─── GoKwik Checkout ──────────────────────────────────────────────────────────
NEXT_PUBLIC_GOKWIK_MERCHANT_ID=your_gokwik_merchant_id
NEXT_PUBLIC_GOKWIK_ENV=production
NEXT_PUBLIC_GOKWIK_STORE_ID=your_gokwik_store_id
NEXT_PUBLIC_ENABLE_GOKWIK=true

# ─── Shopify Webhook (server-side — never expose to client) ───────────────────
# Generate in Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret_here
